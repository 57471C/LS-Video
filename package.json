{
  "name": "ls-video",
  "version": "0.6.3",
  "description": "LS.Video — media player with timeline bookmarking and batch processing",
  "scripts": {
    "test": "vitest run",
    "start": "tauri dev",
    "build:exe": "tauri build",
    "build:css": "tailwindcss -i ./ui/input.css -o ./ui/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./ui/input.css -o ./ui/tailwind.css --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "tauri": "tauri",
    "build": "tauri build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tauri-apps/cli": "^2",
    "tailwindcss": "^3.4.17",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-shell": "^2"
  }
}
