{
  "name": "ls-video",
  "version": "0.6.0",
  "description": "A Windows Video Player/Editor with multiple view modes and encoding capabilities.",
  "main": "ui/index.html",
  "scripts": {
    "test": "vitest run",
    "start": "tauri dev",
    "build:exe": "tauri build",
    "build:css": "tailwindcss -i ./ui/input.css -o ./ui/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./ui/input.css -o ./ui/tailwind.css --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "keywords": [
    "ls-video",
    "video",
    "media player",
    "video editor"
  ],
  "author": "Terry Minett",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/cli": "^4.3.0",
    "@tauri-apps/cli": "^2.0.0",
    "husky": "^9.1.6",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.10",
    "tailwindcss": "^4.3.0",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "**/*.{js,json,css,html,md}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7"
  }
}
