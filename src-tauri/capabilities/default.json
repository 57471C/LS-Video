{
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "core:window:allow-center",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-size",
    "core:window:allow-set-resizable",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-always-on-top",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$TEMP" },
        { "path": "$TEMP/**" },
        { "path": "$CACHE" },
        { "path": "$CACHE/**" },
        { "path": "$LOCALDATA" },
        { "path": "$LOCALDATA/**" },
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$APPCACHE" },
        { "path": "$APPCACHE/**" },
        { "path": "$DOWNLOAD" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP" },
        { "path": "$DESKTOP/**" },
        { "path": "$VIDEO" },
        { "path": "$VIDEO/**" },
        { "path": "$PICTURE" },
        { "path": "$PICTURE/**" },
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "$RESOURCE" },
        { "path": "$RESOURCE/**" },
        { "path": "\\\\**" },
        { "path": "\\\\?\\UNC\\**" }
      ],
      "deny": [
        { "path": "$HOME/.ssh/*" },
        { "path": "$SYSTEM/*" }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://lean.studio" },
        { "url": "https://lean.studio/*" },
        { "url": "https://www.lean.studio" },
        { "url": "https://www.lean.studio/*" },
        { "url": "https://speeddf.com" },
        { "url": "https://speeddf.com/*" },
        { "url": "https://www.speeddf.com" },
        { "url": "https://www.speeddf.com/*" },
        { "url": "https://buymeacoffee.com/*" },
        { "url": "https://www.buymeacoffee.com/*" }
      ]
    }
  ]
}