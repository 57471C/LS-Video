{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LS.Video",
  "version": "0.6.5",
  "identifier": "com.leanstudio.lsvideo",
  "build": {
    "devUrl": null,
    "frontendDist": "../ui",
    "beforeDevCommand": "npm run build:css",
    "beforeBuildCommand": "npm run build:css"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LS.Video - v0.6.5",
        "width": 1028,
        "height": 786,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: asset.localhost http://asset.localhost https://asset.localhost data: blob:; media-src 'self' asset: asset.localhost http://asset.localhost https://asset.localhost blob:; connect-src 'self' ipc: ipc.localhost http://ipc.localhost https://ipc.localhost http://127.0.0.1:* https://lean.studio https://lean.studio/* https://www.lean.studio https://www.lean.studio/* https://github.com https://github.com/* https://objects.githubusercontent.com https://objects.githubusercontent.com/*",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "name": "LS.Video Project",
        "ext": [
          "lsv",
          "lsvz",
          "tmv",
          "tmvz"
        ],
        "description": "LS.Video Project File",
        "role": "Editor"
      },
      {
        "name": "Media File",
        "ext": [
          "mp4",
          "mkv",
          "avi",
          "mov",
          "mpg",
          "mpeg"
        ],
        "description": "Media File",
        "role": "Viewer"
      }
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEOEE5NkY2NzM2MTY0QzAKUldUQVpHRno5cGFLTFoxTktETkpqOEZ3SHNpUzBFRytZaHBUYXVzT0gzd1RqYXJTSFd0akNLTlcK",
      "endpoints": [
        "https://lean.studio/lsvideo/latest.json"
      ]
    }
  }
}